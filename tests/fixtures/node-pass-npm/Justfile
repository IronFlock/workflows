# Recipe contract of a Node repository (npm), in its smallest form.

lint:
    node --check sum.js

test:
    node --test

build:
    node -e 'import("./sum.js").then((m) => process.exit(m.sum(1, 1) === 2 ? 0 : 1))'

# For the self-test of node-gate's `tools` input: bun must be on PATH.
test-with-tool:
    bun --version
    node --test
